{
  "manifest_version": 3,
  "name": "eBay Sold History Button",
  "version": "1.1.1",
  "description": "Captures the login-required purchase-history page for eBay items you view, for verified 7-day sales data.",
  "host_permissions": ["https://www.ebay.co.uk/*"],
  "permissions": ["storage", "activeTab"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.ebay.co.uk/itm/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "eBay Sold History"
  }
}
