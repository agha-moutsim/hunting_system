# eBay Hunter — Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ebay_hunter

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# eBay Browse API (FREE — 5,000 calls/day)
# Get keys at: https://developer.ebay.com
# EBAY_ENVIRONMENT: "production" (real data) or "sandbox" (test data)
EBAY_ENVIRONMENT=production
EBAY_CLIENT_ID=your_client_id_here
EBAY_CLIENT_SECRET=your_client_secret_here
EBAY_MARKETPLACE=EBAY_GB

# Optional: ScrapingBee for anti-bot bypass (paid)
SCRAPINGBEE_API_KEY=

# Optional: ScraperAPI for anti-bot bypass (paid)
SCRAPERAPI_KEY=
