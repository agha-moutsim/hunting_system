# eBay Hunter — Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ebay_hunter

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# eBay Browse API (FREE — 5,000 calls/day)
# Get keys at: https://developer.ebay.com
EBAY_ENVIRONMENT=production
EBAY_CLIENT_ID=your_client_id_here
EBAY_CLIENT_SECRET=your_client_secret_here
EBAY_MARKETPLACE=EBAY_GB

# ─── Supplier APIs (FREE) ──────────────────────────────────────

# CJ Dropshipping API (100% FREE)
# Register at: https://developers.cjdropshipping.com
# Get API key at: https://www.cjdropshipping.com/my.html#/authorize/API
CJ_API_KEY=
CJ_ACCESS_TOKEN=

# Amazon UK PA API (FREE with Associates account)
# Sign up at: https://affiliate-program.amazon.co.uk
# Requires 3 qualifying sales in 30 days to maintain access
AMAZON_PA_ACCESS_KEY=
AMAZON_PA_SECRET_KEY=
AMAZON_PA_PARTNER_TAG=

# RapidAPI AliExpress (FREE tier: 30 req/min)
# Get free key at: https://rapidapi.com/aliexpressapi/api/aliexpress-api/
RAPIDAPI_KEY=

# SerpApi Google Shopping (FREE tier: 5,000 searches/month)
# Covers B&Q, Toolstation, and 100+ UK retailers
# Get free key at: https://serpapi.com
SERPAPI_KEY=

# ─── Optional: Anti-bot Bypass (paid) ──────────────────────────
SCRAPINGBEE_API_KEY=
SCRAPERAPI_KEY=
